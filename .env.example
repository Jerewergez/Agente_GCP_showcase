# Agente_GCP — Environment Configuration
# cp .env.example .env

# Backend
PORT=8080
GCP_PROJECT=dev1pruebas
GCP_SA_KEY_PATH=~/.gcp/dev1pruebas-key.json
BQ_DATASET_SILVER=ANALYTICS_SILVER
BQ_DATASET_GOLD=ANALYTICS_GOLD

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Gemma Cloud Run
GEMMA_CLOUD_RUN_URL=
GEMMA_MODEL=gemma-2b

# OpenCode (local mode)
OPENCODE_BIN=opencode
OPENCODE_MODEL=gemma-like

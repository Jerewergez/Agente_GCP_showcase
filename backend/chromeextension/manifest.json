{
  "manifest_version": 3,
  "name": "Agente_GCP",
  "version": "0.1.0",
  "description": "Asistente BigQuery + Google Workspace — consultas, exportación y ML desde el navegador",
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "tabs"
  ],
  "oauth2": {
    "client_id": "",
    "scopes": [
      "https://www.googleapis.com/auth/bigquery.readonly",
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/chat.readonly"
    ]
  },
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://bigquery.googleapis.com/*"
  ],
  "action": {
    "default_title": "Agente_GCP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
